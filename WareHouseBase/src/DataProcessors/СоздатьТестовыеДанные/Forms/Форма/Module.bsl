&НаСервере
Функция СоздатьТестовыеДанные()
    Результат = "";
    
    // 1. Создаём Номенклатуру
    Попытка
        Номенклатура1 = СоздатьЭлементСправочника("Номенклатура", "Товар А");
        Номенклатура2 = СоздатьЭлементСправочника("Номенклатура", "Товар Б");
        Номенклатура3 = СоздатьЭлементСправочника("Номенклатура", "Товар В");
        Результат = Результат + "Номенклатура создана. ";
    Исключение
        Результат = Результат + "Ошибка справочника Номенклатура: " + ОписаниеОшибки() + " ";
    КонецПопытки;
    
    // 2. Создаём Контрагентов
    Попытка
        Покупатель1 = СоздатьЭлементСправочника("Контрагенты", "ООО Ромашка");
        Покупатель2 = СоздатьЭлементСправочника("Контрагенты", "ИП Иванов");
        Покупатель3 = СоздатьЭлементСправочника("Контрагенты", "ООО Лютик");
        Результат = Результат + "Контрагенты созданы. ";
    Исключение
        Результат = Результат + "Ошибка справочника Контрагенты: " + ОписаниеОшибки() + " ";
    КонецПопытки;
    
    // 3. Записываем движения в регистр Продажи
    Попытка
        НаборЗаписей = РегистрыНакопления.Продажи.СоздатьНаборЗаписей();
        НаборЗаписей.Очистить();
        
        // Продажа 1
        Движение = НаборЗаписей.Добавить();
        Движение.Период = ТекущаяДата();
        Движение.Номенклатура = Номенклатура1;
        Движение.Покупатель = Покупатель1;
        Движение.Количество = 10;
        Движение.Сумма = 5000;
        
        // Продажа 2
        Движение = НаборЗаписей.Добавить();
        Движение.Период = ТекущаяДата();
        Движение.Номенклатура = Номенклатура2;
        Движение.Покупатель = Покупатель1;
        Движение.Количество = 5;
        Движение.Сумма = 3000;
        
        // Продажа 3
        Движение = НаборЗаписей.Добавить();
        Движение.Период = ТекущаяДата();
        Движение.Номенклатура = Номенклатура3;
        Движение.Покупатель = Покупатель2;
        Движение.Количество = 20;
        Движение.Сумма = 12000;
        
        // Продажа 4
        Движение = НаборЗаписей.Добавить();
        Движение.Период = ТекущаяДата();
        Движение.Номенклатура = Номенклатура1;
        Движение.Покупатель = Покупатель3;
        Движение.Количество = 15;
        Движение.Сумма = 7500;
        
        НаборЗаписей.Записать();
        Результат = Результат + "Движения по продажам созданы. ";
    Исключение
        Результат = Результат + "Ошибка регистра Продажи: " + ОписаниеОшибки() + " ";
    КонецПопытки;
    
    Возврат Результат;
КонецФункции

&НаСервере
Функция СоздатьЭлементСправочника(ИмяСправочника, Наименование)
    // Ищем, нет ли уже такого элемента
    Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование);
    Если Не Ссылка.Пустая() Тогда
        Возврат Ссылка;
    КонецЕсли;
    
    // Создаём новый
    НовыйЭлемент = Справочники[ИмяСправочника].СоздатьЭлемент();
    НовыйЭлемент.Наименование = Наименование;
    НовыйЭлемент.Записать();
    Возврат НовыйЭлемент.Ссылка;
КонецФункции

&НаКлиенте
Процедура СоздатьДанные(Команда)
    Результат = СоздатьТестовыеДанные();
    Сообщить(Результат);
КонецПроцедуры